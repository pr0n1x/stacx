# File-based context configuration (gitignored copies in the project root).
#
#     cp stack/context/examples/context.example.env context.env
#     cp stack/context/examples/context.example.env context.<ctx>.env
#
# `context.env` is the checkout's identity:
# - COMPOSE_PROJECT_NAME = <base> or <base>-<ctx>
# - COMPOSE_CONTEXT_BASE — sets the <base>; defaults to the checkout
#   directory's name
# - COMPOSE_CONTEXT — sets the <ctx>
#
# The COMPOSE_CTX_* knobs can live in either file; `context.<ctx>.env`
# overrides `context.env`.
#
# The environment wins over either file, per variable; values are taken
# literally (surrounding quotes stripped), nothing is evaluated, and a
# trailing comment would join the value — comments live on their own
# lines.

#COMPOSE_CONTEXT_BASE="<base>"
#COMPOSE_CONTEXT="<ctx>"
#COMPOSE_CTX_PROFILES="all"
# The override tiers, declared as extensionless stems — nothing is
# auto-discovered. `%compose` expands to the base file's stem
# (`docker-compose` or `compose`), `%context` to the context name;
# colon-separated for more than one tier. Each stem is probed:
# `<stem>.ya?ml` joins the compose files, `<stem>.env` the env files (for
# redeclaring e.g. an image-version variable). `stack/compose
# --no-override` clears this. Safe in the one-file `context.env` form:
# `.%context` drops its dot for the default context, and a tier matching
# nothing is skipped with a stderr note.
COMPOSE_CTX_OVERRIDES="%compose.%context.local"
